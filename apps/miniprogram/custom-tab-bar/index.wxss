.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  background: #ffffff;
  border-top: 1rpx solid var(--wc-color-border-default);
  box-shadow: 0 -2rpx 16rpx rgba(30, 70, 120, 0.06);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: var(--wc-zIndex-sticky);
}

.tab-item {
  flex: 1;
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--wc-color-text-tertiary);
  font-size: 26rpx;
}

.tab-item.active {
  color: var(--wc-color-brand-primary);
  font-weight: 600;
}

.tab-label {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: var(--wc-radius-pill);
}

.tab-item.active .tab-label {
  background: #E8F1FF;
}
