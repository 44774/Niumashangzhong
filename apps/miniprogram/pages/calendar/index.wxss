.month-bar {
  margin-bottom: 24rpx;
}

.month-nav {
  gap: 20rpx;
}

.month-label {
  font-size: 36rpx;
  font-weight: 700;
}

.month-arrow {
  width: 64rpx;
  height: 64rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 44rpx;
  color: var(--wc-color-brand-primary);
  background: var(--wc-color-surface-card);
  border-radius: 50%;
}

.today-btn {
  background: var(--wc-color-surface-subtle);
  color: var(--wc-color-brand-primary);
  border-radius: var(--wc-radius-pill);
  font-size: 26rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  border: none;
}

.month-bar .row {
  gap: 12rpx;
}

.today-main {
  margin-top: 20rpx;
}

.today-time {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--wc-color-brand-primary);
}

.today-meta {
  display: flex;
  gap: 24rpx;
  color: var(--wc-color-text-secondary);
  font-size: 26rpx;
  margin-top: 12rpx;
}

.today-actions {
  gap: 20rpx;
  margin-top: 20rpx;
}

.today-action {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
}
