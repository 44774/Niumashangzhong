.calendar-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 24rpx 32rpx 0;
  overflow: hidden;
}

.month-bar {
  margin-bottom: 24rpx;
  flex-shrink: 0;
}

.month-nav {
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}

.month-label {
  font-size: 36rpx;
  font-weight: 700;
  white-space: nowrap;
  flex-shrink: 0;
}

.month-picker {
  padding: 8rpx 20rpx;
  border-radius: var(--wc-radius-md);
  background: var(--wc-color-surface-card);
}

.month-arrow {
  width: 64rpx;
  height: 64rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 44rpx;
  color: var(--wc-color-brand-primary);
  background: var(--wc-color-surface-card);
  border-radius: 50%;
}

.today-btn {
  background: var(--wc-color-surface-subtle);
  color: var(--wc-color-brand-primary);
  border-radius: var(--wc-radius-pill);
  font-size: 26rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  border: none;
}

.calendar-area {
  flex: 1;
  min-height: 0;
  position: relative;
}

.calendar-scroll {
  height: 100%;
}

.calendar-list {
  padding-bottom: 16rpx;
}

.month-block {
  margin-bottom: 24rpx;
}

.back-today-btn {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #ffffff;
  border: 2rpx solid var(--wc-color-brand-primary);
  color: var(--wc-color-brand-primary);
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--wc-shadow-sm);
  z-index: var(--wc-zIndex-sticky);
}

.today-card {
  flex-shrink: 0;
  margin-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.month-bar .row {
  gap: 12rpx;
}

.today-main {
  margin-top: 20rpx;
}

.today-time {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--wc-color-brand-primary);
}

.today-meta {
  display: flex;
  gap: 24rpx;
  color: var(--wc-color-text-secondary);
  font-size: 26rpx;
  margin-top: 12rpx;
}

.weather-line {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 12rpx;
  background: var(--wc-color-surface-subtle);
  border-radius: var(--wc-radius-md);
  padding: 16rpx 20rpx;
}

.weather-condition {
  font-size: 28rpx;
  font-weight: 600;
}

.weather-temp {
  color: var(--wc-color-brand-primary);
  font-size: 28rpx;
  font-weight: 600;
}

.weather-rain {
  color: var(--wc-color-text-secondary);
  font-size: 24rpx;
}

.weather-fallback {
  color: var(--wc-color-text-secondary);
  font-size: 24rpx;
}

.today-actions {
  gap: 20rpx;
  margin-top: 20rpx;
}

.today-action {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
}
