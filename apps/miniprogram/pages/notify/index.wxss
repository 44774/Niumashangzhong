.card-desc {
  display: block;
  color: var(--wc-color-text-secondary);
  font-size: 24rpx;
  margin-top: 8rpx;
}

.reminder-options {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 24rpx;
}

.reminder-option {
  padding: 16rpx 28rpx;
  border-radius: var(--wc-radius-pill);
  background: var(--wc-color-surface-subtle);
  color: var(--wc-color-text-secondary);
  font-size: 26rpx;
}

.reminder-option.checked {
  background: var(--wc-color-brand-primary);
  color: var(--wc-color-text-inverse);
  font-weight: 600;
}

.switch-row {
  padding: 16rpx 0;
}

.switch-title {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
}

.switch-desc {
  display: block;
  color: var(--wc-color-text-tertiary);
  font-size: 24rpx;
  margin-top: 4rpx;
}

.quiet-row {
  gap: 20rpx;
  margin-top: 20rpx;
}

.quiet-picker {
  background: var(--wc-color-surface-subtle);
  border-radius: var(--wc-radius-md);
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.quiet-sep {
  color: var(--wc-color-text-tertiary);
}

.subscribe-btn {
  margin-top: 24rpx;
}

.subscribe-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--wc-color-border-default);
  font-size: 28rpx;
}

.subscribe-row:last-of-type {
  border-bottom: none;
}

.subscribe-row-status {
  color: var(--wc-color-brand-primary);
  font-size: 26rpx;
}

.subscribe-empty {
  margin-top: 20rpx;
  color: var(--wc-color-text-tertiary);
  font-size: 24rpx;
}

.subscribe-status {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
}
