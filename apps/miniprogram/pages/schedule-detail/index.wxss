.hero-card {
  background: linear-gradient(135deg, var(--wc-color-brand-primary), var(--wc-color-brand-cyan));
  box-shadow: var(--wc-shadow-md);
}

.hero-date {
  color: rgba(255, 255, 255, 0.9);
  font-size: 26rpx;
}

.hero-shift {
  gap: 20rpx;
  margin-top: 16rpx;
}

.hero-status {
  background: rgba(245, 158, 11, 0.9);
  color: #ffffff;
  font-size: 24rpx;
  border-radius: var(--wc-radius-pill);
  padding: 8rpx 20rpx;
}

.ot-status {
  background: rgba(239, 68, 68, 0.9);
}

.hero-time {
  display: block;
  margin-top: 20rpx;
  color: #ffffff;
  font-size: 52rpx;
  font-weight: 700;
}

.hero-rest {
  display: block;
  margin-top: 20rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 30rpx;
}

.hero-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 26rpx;
}

.detail-actions {
  gap: 20rpx;
  margin: 8rpx 0 24rpx;
}

.detail-action {
  flex: 1;
}

.history-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--wc-color-border-default);
  font-size: 26rpx;
}

.history-row:last-child {
  border-bottom: none;
}

.history-version {
  color: var(--wc-color-brand-primary);
  font-weight: 600;
}

.history-text {
  flex: 1;
  color: var(--wc-color-text-primary);
}

.history-time {
  color: var(--wc-color-text-tertiary);
  font-size: 22rpx;
}
