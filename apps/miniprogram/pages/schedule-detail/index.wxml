<view class="page">
  <block wx:if="{{loading}}">
    <skeleton cards="3" rows="3" />
  </block>
  <error-state wx:elif="{{error}}" message="{{errorMessage}}" bind:retry="load" />
  <empty-state
    wx:elif="{{!detail}}"
    title="{{dateLabel}} 还没有排班"
    desc="添加一个班次，让工作安排一目了然"
    action-text="添加排班"
    bind:action="addSchedule"
  />
  <block wx:else>
    <view class="card hero-card">
      <text class="hero-date">{{dateLabel}}</text>
      <view class="row hero-shift">
        <shift-badge
          name="{{detail.shiftSnapshot.name}}"
          short-name="{{detail.shiftSnapshot.shortName}}"
          color="{{detail.shiftSnapshot.color}}"
          size="lg"
        />
        <text class="hero-status" wx:if="{{detail.status === 'pending_approval'}}">待审批</text>
        <text class="hero-status ot-status" wx:if="{{overtime}}">加班</text>
      </view>
      <text class="hero-time" wx:if="{{timeText}}">{{timeText}}</text>
      <text class="hero-rest" wx:else>休息日 · 无上下班时间</text>
      <view class="hero-meta" wx:if="{{duration || location || note}}">
        <text wx:if="{{duration}}">{{duration}}</text>
        <text wx:if="{{location}}">{{location}}</text>
        <text wx:if="{{note}}">{{note}}</text>
      </view>
    </view>

    <view class="card">
      <view class="row-between">
        <text class="title-card">天气</text>
        <text class="text-tertiary">基于默认城市</text>
      </view>
      <view class="section-gap"></view>
      <weather-card weather="{{detail.weather}}" loading="{{false}}" error="{{weatherError}}" />
    </view>

    <view class="row detail-actions">
      <button class="btn-primary detail-action" bindtap="changeShift">临时改班</button>
      <button class="btn-secondary detail-action" bindtap="shareSchedule">分享班表</button>
    </view>

    <view class="card" wx:if="{{detail.history.length > 0}}">
      <text class="title-card">变更记录</text>
      <view wx:for="{{detail.history}}" wx:key="version" class="history-row">
        <text class="history-version">v{{item.version}}</text>
        <text class="history-text">{{item.snapshot.name}} · {{item.changeReason || '无备注'}}</text>
        <text class="history-time">{{item.createdAtText}}</text>
      </view>
    </view>

    <view class="card" wx:if="{{changeRecords.length > 0}}">
      <text class="title-card">当日改班记录</text>
      <view wx:for="{{changeRecords}}" wx:key="id" class="history-row">
        <text class="history-version">改</text>
        <text class="history-text">{{item.originalSnapshot.name}} → {{item.requestedSnapshot.name}}</text>
        <text class="history-time">{{item.createdAtText}}</text>
        <text class="record-delete" data-id="{{item.id}}" bindtap="removeChangeRecord">删除</text>
      </view>
    </view>
  </block>
</view>
