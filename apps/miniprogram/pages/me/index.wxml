<view class="page">
  <view class="card profile">
    <view class="avatar">{{avatarText}}</view>
    <view class="profile-info">
      <text class="profile-name">{{user.displayName || '未登录'}}</text>
      <text class="profile-sub">{{workspace.name}}</text>
    </view>
  </view>

  <view class="card menu">
    <view class="menu-item" bindtap="goShiftManage">
      <text>班次管理</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goChangeRecords">
      <text>改班记录</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goShareSettings">
      <text>分享设置</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goNotify">
      <text>提醒设置</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goLocation">
      <text>位置设置</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="card">
    <view class="menu-item" bindtap="showAbout">
      <text>关于与隐私</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <button class="btn-secondary btn-block logout-btn" bindtap="logout">退出登录</button>
  <text class="text-tertiary version">工作日历 v0.1.0 · 个人模式</text>
</view>
