.login-page {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 100vh;
}

.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 48rpx;
}

.brand-logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 111, 235, 0.15);
}

.brand-logo-img {
  width: 100%;
  height: 100%;
}

.brand-name {
  margin-bottom: 8rpx;
}

.brand-desc {
  color: var(--wc-color-text-secondary);
  font-size: 26rpx;
}

.login-card {
  padding: 40rpx 32rpx;
}

.login-btn {
  margin-top: 32rpx;
  margin-bottom: 20rpx;
}

.login-hint {
  display: block;
  margin-top: 24rpx;
  color: var(--wc-color-text-tertiary);
  font-size: 22rpx;
  line-height: 1.6;
}
