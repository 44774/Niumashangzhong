<view class="page login-page">
  <view class="brand">
    <view class="brand-logo">
      <image class="brand-logo-img" src="/assets/logo.png" mode="aspectFit" />
    </view>
    <text class="title-lg brand-name">{{appName}}</text>
    <text class="brand-desc">一眼看清哪天上班、几点上班、天气如何</text>
  </view>

  <view class="card login-card">
    <text class="field-label">昵称（可选）</text>
    <input
      class="field-input"
      type="nickname"
      placeholder="例如：张小明"
      value="{{displayName}}"
      bindinput="onInput"
      maxlength="20"
    />
    <text class="login-hint">微信登录时如未填写昵称，将自动获取微信昵称与头像。</text>
    <button class="btn-primary btn-block login-btn" loading="{{loading}}" bindtap="onWechatLogin">
      微信一键登录
    </button>
    <button class="btn-secondary btn-block" loading="{{loading}}" bindtap="onLocalLogin">
      本地登录
    </button>
    <text class="login-hint">
      微信云登录：数据保存在云端，可多设备同步。本地登录：班表数据仅保存在本机，清除小程序数据或更换设备后将无法找回。
    </text>
  </view>
</view>
