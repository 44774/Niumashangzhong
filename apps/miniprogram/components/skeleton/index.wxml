<view class="skeleton">
  <block wx:if="{{variant === 'calendar'}}">
    <view class="sk-card">
      <view class="sk-line w40"></view>
      <view class="sk-grid">
        <view class="sk-grid-cell" wx:for="{{gridCells}}" wx:key="*this"></view>
      </view>
    </view>
    <view class="sk-card">
      <view class="sk-line w30"></view>
      <view class="sk-line w80"></view>
      <view class="sk-line w60"></view>
    </view>
  </block>

  <block wx:elif="{{variant === 'form'}}">
    <view class="sk-card">
      <view class="sk-line w30"></view>
      <view class="sk-field"></view>
      <view class="sk-line w30"></view>
      <view class="sk-field"></view>
      <view class="sk-line w50"></view>
      <view class="sk-field"></view>
    </view>
    <view class="sk-card">
      <view class="sk-line w40"></view>
      <view class="sk-line w100"></view>
    </view>
  </block>

  <block wx:else>
    <view class="sk-card" wx:for="{{cards}}" wx:key="*this">
      <view class="sk-line w50"></view>
      <view class="sk-line w100"></view>
      <view class="sk-line w80" wx:if="{{rows > 2}}"></view>
    </view>
  </block>
</view>
