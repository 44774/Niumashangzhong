.skeleton {
  padding: 4rpx 0;
}

.sk-card {
  background: var(--wc-color-surface-card);
  border-radius: var(--wc-radius-lg);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--wc-shadow-sm);
}

.sk-line,
.sk-field,
.sk-grid-cell {
  position: relative;
  overflow: hidden;
  background: var(--wc-color-surface-subtle);
  border-radius: var(--wc-radius-sm);
}

.sk-line {
  height: 32rpx;
  margin-bottom: 20rpx;
}

.sk-field {
  height: 88rpx;
  margin-bottom: 24rpx;
}

.sk-line::after,
.sk-field::after,
.sk-grid-cell::after {
  content: "";
  position: absolute;
  left: -100%;
  top: 0;
  height: 100%;
  width: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.65), transparent);
  animation: sk-shimmer 1.3s infinite;
}

@keyframes sk-shimmer {
  0% {
    left: -100%;
  }
  100% {
    left: 100%;
  }
}

.sk-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 24rpx;
}

.sk-grid-cell {
  width: calc((100% - 60rpx) / 7);
  height: 76rpx;
  border-radius: 12rpx;
}

.w20 {
  width: 20%;
}

.w30 {
  width: 30%;
}

.w40 {
  width: 40%;
}

.w50 {
  width: 50%;
}

.w60 {
  width: 60%;
}

.w80 {
  width: 80%;
}

.w100 {
  width: 100%;
}
