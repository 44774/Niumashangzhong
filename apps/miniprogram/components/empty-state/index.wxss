.empty {
  padding: 80rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--wc-color-surface-subtle);
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-desc {
  color: var(--wc-color-text-secondary);
  font-size: 26rpx;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.empty-action {
  min-width: 240rpx;
}
