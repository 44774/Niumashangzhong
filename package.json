{
  "name": "niuma-shangzhong",
  "version": "0.1.0",
  "private": true,
  "description": "牛马上钟微信小程序",
  "scripts": {
    "gen:tokens": "node scripts/gen-tokens.mjs",
    "sync:types": "node scripts/sync-miniprogram-types.mjs",
    "build": "pnpm -r build && node scripts/build-cloudfunctions.mjs",
    "build:cloud": "node scripts/build-cloudfunctions.mjs",
    "init:cloud": "node scripts/init-cloud-db.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @workcal/api test:integration",
    "db:migrate": "pnpm --filter @workcal/api db:migrate",
    "db:seed": "pnpm --filter @workcal/api db:seed",
    "dev:api": "pnpm --filter @workcal/api dev",
    "smoke:api": "powershell -ExecutionPolicy Bypass -File scripts/smoke-api.ps1",
    "smoke:mp": "node scripts/miniprogram-smoke.mjs",
    "smoke:mp:all": "powershell -ExecutionPolicy Bypass -File scripts/run-mp-smoke.ps1"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "miniprogram-automator": "^0.12.1"
  }
}
