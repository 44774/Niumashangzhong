# 服务端
PORT=3000
DATABASE_URL=postgres://workcal:workcal_dev@127.0.0.1:5432/workcal
DATABASE_URL_TEST=postgres://workcal:workcal_dev@127.0.0.1:5432/workcal_test
JWT_SECRET=change-me-in-production

# 微信小程序（留空时后端自动进入开发登录模式）
WECHAT_APPID=
WECHAT_SECRET=

# 天气：本地 Fastify 回退模式使用 mock；小程序云模式使用 Open-Meteo（无需配置）
WEATHER_PROVIDER=mock

# 微信订阅消息模板（小程序云模式）：把模板 ID 填入 cloudbaserc.json 的
# SUBSCRIBE_SHIFT_TEMPLATE_ID / SUBSCRIBE_WEATHER_TEMPLATE_ID 后重新部署云函数
SUBSCRIBE_SHIFT_TEMPLATE_ID=
SUBSCRIBE_WEATHER_TEMPLATE_ID=
SUBSCRIBE_MINIPROGRAM_STATE=developer

# 小程序端 API 地址（微信开发者工具中需勾选“不校验合法域名”）
MINIPROGRAM_API_BASE=http://127.0.0.1:3000/api/v1
